{
  "name": "spotify-playlist-mcp",
  "version": "0.1.0",
  "description": "Guarded Spotify playlist curation tools for Codex scheduled tasks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suhajdab/spotify-playlist-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/suhajdab/spotify-playlist-mcp/issues"
