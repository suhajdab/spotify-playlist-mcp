# Spotify app credentials and redirect URI configured in Spotify Dashboard.
SPOTIFY_CLIENT_ID=replace-with-client-id
SPOTIFY_CLIENT_SECRET=replace-with-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Optional. Defaults to the current user's config directory and mode 0600.
# SPOTIFY_TOKEN_FILE=/absolute/path/to/token.json

# Writes fail closed unless an owned playlist ID is explicitly listed here.
SPOTIFY_ALLOWED_PLAYLIST_IDS=
SPOTIFY_MAX_CHANGES_PER_PLAN=10
